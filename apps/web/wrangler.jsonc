{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production worker. The worker itself is created in infra/; wrangler
  // deploys it and attaches the custom domain.
  "name": "sheetlibrary",
  "compatibility_date": "2026-10-06",
  // Fires request.signal when the client goes away, so photo import stops
  // the call to the model.
  "compatibility_flags": ["enable_request_signal"],
  "main": "./workers/app.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sheetlibrary.com", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // The databases are created in infra/. Bindings aren't inherited by envs,
  // so the preview env repeats them.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sheetlibrary",
      "database_id": "75d27270-9d84-4a2d-89f2-465359984167",
    },
  ],
  // Sign-in emails. On Workers Free, only verified addresses get them.
  "send_email": [{ "name": "EMAIL" }],
  // Set by hand with `wrangler secret put`. Local dev reads them from
  // .dev.vars. Production and the preview have separate Anthropic API keys.
  "secrets": { "required": ["BETTER_AUTH_SECRET", "ANTHROPIC_API_KEY"] },
  // Photo import reads photos with Claude through the AI gateway in infra/.
  // Local dev and the end-to-end tests set PHOTO_MODEL to "fake".
  "vars": {
    "PHOTO_MODEL": "claude",
    "PHOTO_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/2a6fd0d4958405587e8d5fc78066a0fb/sheetlibrary/anthropic",
  },
  "env": {
    // Pull request previews. Select at build time with CLOUDFLARE_ENV=preview.
    "preview": {
      "name": "sheetlibrary-preview",
      // Previews only get preview URLs, never the production domain.
      "routes": [],
      // Preview URLs fail with error 1042 while workers.dev is off
      // (https://github.com/cloudflare/workers-sdk/issues/15890).
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sheetlibrary-preview",
          "database_id": "4eae04d8-718f-4179-b4a6-5db18e1cafad",
        },
      ],
      "send_email": [{ "name": "EMAIL" }],
      "secrets": { "required": ["BETTER_AUTH_SECRET", "ANTHROPIC_API_KEY"] },
      "vars": {
        // Pull request tokens can't reach D1, so the preview applies its own
        // migrations through its binding. See openspec/specs/site-hosting.
        "PREVIEW_MIGRATIONS": "on",
        "PHOTO_MODEL": "claude",
        "PHOTO_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/2a6fd0d4958405587e8d5fc78066a0fb/sheetlibrary/anthropic",
      },
    },
  },
}
