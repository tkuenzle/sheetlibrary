{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production worker, served at sheetlibrary.com. The worker itself and the
  // custom domain are managed in infra/.
  "name": "sheetlibrary",
  "compatibility_date": "2026-10-06",
  "main": "./workers/app.ts",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "env": {
    // Pull request previews. Select at build time with CLOUDFLARE_ENV=preview.
    "preview": {
      "name": "sheetlibrary-preview",
      "workers_dev": false,
      "preview_urls": true,
    },
  },
}
